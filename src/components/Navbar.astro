---
import { useTranslations, locales, defaultLocale, localizePath } from '@/lib/i18n'
import { localeLabels, localeFlags } from '@/lib/locales'
import { siteConfig } from '@/lib/site.config'
import Logo from '@/components/Logo.astro'
import type { Locale } from '@/lib/i18n'

interface NavLink {
    label: string
    href: string
}

interface Props {
    /** Override the default links from site.config.ts. */
    links?: NavLink[]
    /** Hide the language dropdown + mobile language pills. */
    showLanguageSwitcher?: boolean
}
const locale = (Astro.currentLocale ?? defaultLocale) as Locale
const t = useTranslations(locale)

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
const homeHref = localizePath(locale, '/')

const nav: NavLink[] = siteConfig.nav.map((l) => ({
    label: t(l.labelKey),
    href: localizePath(locale, l.path),
}))

const { links = nav, showLanguageSwitcher = true } = Astro.props

function isActive(href: string): boolean {
    const clean = href.replace(/\/$/, '') || '/'
    return clean === (currentPath || '/')
}
---

<nav class="theme-nav sticky top-0 z-50 px-4 sm:px-6 py-3" aria-label={t('nav.aria.main')}>
    <div class="max-w-6xl mx-auto flex items-center justify-between">
        <slot name="logo">
            <Logo href={homeHref} label={t('site.name')} />
        </slot>

        <div class="hidden lg:flex items-center gap-1">
            {links.map((item) => (
                <a
                    href={item.href}
                    class:list={[
                        'relative px-3 py-1.5 text-sm rounded-control transition-all duration-200',
                        isActive(item.href)
                            ? 'font-medium text-fg bg-accent-soft'
                            : 'text-muted hover:text-fg hover:bg-surface-soft',
                    ]}
                >
                    {item.label}
                    {isActive(item.href) && (
                        <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-5 h-0.5 bg-accent"></span>
                    )}
                </a>
            ))}
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2">
            <!-- Extra per-project controls (CTA button, search, …) -->
            <slot name="actions" />

            <!-- Language dropdown -->
            {showLanguageSwitcher && (
            <div class="hidden sm:block relative" id="lang-dropdown-wrap">
                <button
                        id="lang-dropdown-btn"
                        class="flex items-center justify-center w-8 h-8 rounded-control text-dim border border-line transition-all duration-200 hover:text-fg hover:bg-surface-soft"
                        aria-label={t('nav.aria.language')}
                        aria-expanded="false"
                >
                    <!-- Globe icon -->
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A8.966 8.966 0 0 1 3 12c0-1.264.26-2.467.732-3.558" />
                    </svg>
                </button>
                <div
                        id="lang-dropdown-panel"
                        class="absolute right-0 top-full mt-2 min-w-[140px] rounded-card overflow-hidden bg-surface border border-line shadow-panel backdrop-blur-[20px] opacity-0 invisible transition-all duration-200 origin-top-right scale-95"
                >
                    <div class="py-1">
                        {locales.map((l) => (
                                <a
                                        href={localizePath(l, currentPath)}
                                        class:list={[
                                            'flex items-center gap-2.5 px-3 py-2 text-xs font-mono transition-colors duration-150 hover:bg-surface-soft',
                                            l === locale ? 'font-semibold text-fg' : 'text-muted hover:text-fg',
                                        ]}
                                >
                                    <span class="text-sm leading-none">{localeFlags[l]}</span>
                                    <span class="flex-1">{localeLabels[l]}</span>
                                    {l === locale && (
                                            <span class="w-1.5 h-1.5 rounded-full bg-accent shadow-[0_0_6px_var(--accent-glow)]"></span>
                                    )}
                                </a>
                        ))}
                    </div>
                </div>
            </div>
            )}

            <!-- Mobile hamburger -->
            <button
                id="mobile-menu-btn"
                class="lg:hidden flex items-center justify-center w-9 h-9 rounded-control border border-line transition-all duration-200 hover:bg-surface-soft"
                aria-label={t('nav.aria.menu')}
                aria-expanded="false"
            >
                <svg id="burger-icon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                </svg>
                <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    </div>
        <div
                id="mobile-menu"
                class="lg:hidden overflow-hidden transition-all duration-300 ease-in-out"
                style="max-height: 0; opacity: 0;"
        >
            <div class="pt-4 pb-2 space-y-1">
                {links.map((item) => (
                        <a
                                href={item.href}
                                class:list={[
                                    'flex items-center gap-3 px-3 py-2.5 rounded-control text-sm transition-all duration-200',
                                    isActive(item.href)
                                        ? 'font-medium text-fg bg-accent-soft'
                                        : 'text-muted hover:text-fg hover:bg-surface-soft',
                                ]}
                        >
                            {isActive(item.href) && (
                                    <span class="w-1.5 h-1.5 rounded-full bg-accent shadow-[0_0_6px_var(--accent-glow)]"></span>
                            )}
                            {item.label}
                        </a>
                ))}

                {showLanguageSwitcher && <div class="accent-line my-3"></div>}

                <!-- Mobile: language pills -->
                {showLanguageSwitcher && (
                <div class="flex items-center gap-2 px-3 py-2">
                    {locales.map((l) => (
                            <a
                                    href={localizePath(l, currentPath)}
                                    class:list={[
                                        'flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono uppercase tracking-wider rounded-control transition-all duration-200',
                                        l === locale
                                            ? 'font-semibold text-fg bg-accent-soft border border-accent'
                                            : 'text-dim hover:text-fg border border-line',
                                    ]}
                                    aria-label={localeLabels[l]}
                            >
                                {localeFlags[l]} {l}
                            </a>
                    ))}
                </div>
                )}
            </div>
        </div>
</nav>

<script>
    declare global {
        interface Window { __navCtl?: AbortController }
    }

    function initNavbar() {
        if (window.__navCtl) window.__navCtl.abort()
        const ctl = new AbortController()
        window.__navCtl = ctl
        const { signal } = ctl

        /* ── Mobile menu ── */
        const btn = document.getElementById('mobile-menu-btn')
        const menu = document.getElementById('mobile-menu')
        const burgerIcon = document.getElementById('burger-icon')
        const closeIcon = document.getElementById('close-icon')

        if (btn && menu && burgerIcon && closeIcon) {
            let mobileOpen = false
            btn.addEventListener('click', () => {
                mobileOpen = !mobileOpen
                btn.setAttribute('aria-expanded', mobileOpen ? 'true' : 'false')
                if (mobileOpen) {
                    menu.style.maxHeight = menu.scrollHeight + 'px'
                    menu.style.opacity = '1'
                    burgerIcon.classList.add('hidden')
                    closeIcon.classList.remove('hidden')
                } else {
                    menu.style.maxHeight = '0'
                    menu.style.opacity = '0'
                    burgerIcon.classList.remove('hidden')
                    closeIcon.classList.add('hidden')
                }
            }, { signal })
        }

        /* ── Dropdowns ── */
        type Dropdown = { close: () => void }
        const dropdowns: Dropdown[] = []

        function setupDropdown(btnId: string, panelId: string): Dropdown | null {
            const b = document.getElementById(btnId)
            const p = document.getElementById(panelId)
            if (!b || !p) return null
            let isOpen = false
            const open = () => {
                p.style.opacity = '1'
                p.style.visibility = 'visible'
                p.style.transform = 'scale(1)'
                b.setAttribute('aria-expanded', 'true')
                isOpen = true
            }
            const close = () => {
                p.style.opacity = '0'
                p.style.visibility = 'hidden'
                p.style.transform = 'scale(0.95)'
                b.setAttribute('aria-expanded', 'false')
                isOpen = false
            }
            b.addEventListener('click', (e) => {
                e.stopPropagation()
                if (isOpen) close()
                else { closeAll(); open() }
            }, { signal })
            return { close }
        }
        const closeAll = () => { for (const d of dropdowns) d.close() }

        const langDropdown = setupDropdown('lang-dropdown-btn', 'lang-dropdown-panel')
        if (langDropdown) dropdowns.push(langDropdown)

        document.addEventListener('click', closeAll, { passive: true, signal })
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll() }, { signal })
    }

    document.addEventListener('astro:page-load', initNavbar)
</script>
