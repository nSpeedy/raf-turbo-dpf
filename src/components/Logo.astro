---
/**
 * Brand wordmark. Single source for the logo previously duplicated inline
 * in Navbar and Footer — edit here (or replace the component through the
 * parents' `logo` slot) to re-brand the whole site.
 *
 * Text only: the flame glyph that used to sit next to the label was
 * dropped. The mark still lives in `public/favicon.svg` and on the OG
 * card, where an icon has to carry the brand on its own — in the navbar
 * it competed with the accent-red phone button two elements away.
 *
 * `group` is kept for the hover colour; if you put an icon back, it is
 * what lets the icon react to a hover anywhere on the link.
 */
interface Props {
    href: string
    label: string
}
const { href, label } = Astro.props
---

<a href={href} class="group inline-flex items-center">
    <span class="text-sm font-semibold tracking-tight font-mono transition-colors duration-200 group-hover:text-accent">{label}</span>
</a>
