---
/**
 * Brand logo + wordmark. Single source for the mark previously duplicated
 * inline in Navbar and Footer — swap the SVG (or replace this component
 * via the parents' `logo` slot) to re-brand the whole site. All colors
 * come from theme tokens, so it follows the active [data-theme].
 */
interface Props {
    href: string
    label: string
}
const { href, label } = Astro.props
---

<a href={href} class="flex items-center gap-2.5 group">
    <span class="rounded-control inline-flex items-center justify-center w-8 h-8 bg-accent/10 border border-accent/25 transition-colors duration-300 group-hover:border-accent">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M10 1C10 1 4.5 7.5 4.5 12.5a5.5 5.5 0 0 0 11 0C15.5 9 13.5 6 12.5 5.5c0 2-1.5 3-2.5 3C11.5 7 10.5 3.5 10 1Z" fill="var(--accent-from)"/>
            <path d="M10 10.5C10 10.5 8 12 8 13.5a2 2 0 0 0 4 0C12 12 10 10.5 10 10.5Z" fill="var(--accent-to)" opacity="0.6"/>
        </svg>
    </span>
    <span class="text-sm font-semibold tracking-tight font-mono transition-colors duration-200 group-hover:text-accent">{label}</span>
</a>
