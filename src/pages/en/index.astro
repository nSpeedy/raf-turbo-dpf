---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Navbar from '@/components/Navbar.astro'
import Footer from '@/components/Footer.astro'
import { useTranslations } from '@/lib/content'
import { business } from '@/lib/site.config'
import { defaultLocale } from '@/lib/locales'
import type { Locale } from '@/lib/locales'

const locale = (Astro.currentLocale ?? defaultLocale) as Locale
const t = useTranslations(locale)

/* Icons are raw path markup rather than an <Icon> component: six sprites
   used once each don't justify an abstraction, and inlining keeps them
   `currentColor` so they follow the accent token with zero extra CSS. */
const services = [
    { key: 's1', icon: '<circle cx="12" cy="12" r="9"/><path d="M12 3v18M3.6 7.5h16.8M3.6 16.5h16.8"/>' },
    { key: 's2', icon: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.2"/><path d="M12 9.8V3.2M13.9 13.1l5.7 3.3M10.1 13.1l-5.7 3.3"/>' },
    { key: 's3', icon: '<path d="M10 3.5h4v7l-2 2.5-2-2.5z"/><path d="M12 15.5v5M9.3 16.8l-1.2 3.3M14.7 16.8l1.2 3.3"/>' },
    { key: 's4', icon: '<rect x="2.5" y="9" width="12" height="9"/><path d="M6.5 9V5M5.2 5h2.6M10.5 9V5M9.2 5h2.6M14.5 12H21M14.5 15H21"/>' },
    { key: 's5', icon: '<path d="M3.5 18a8.5 8.5 0 1 1 17 0"/><path d="M12 18l4.6-5.8"/><circle cx="12" cy="18" r="1.2"/>' },
    { key: 's6', icon: '<path d="M12 3 20 7.5v9L12 21 4 16.5v-9z"/><circle cx="12" cy="12" r="3.2"/>' },
] as const

const stats = ['s1', 's2', 's3', 's4'] as const
const steps = ['p1', 'p2', 'p3', 'p4'] as const
const reasons = ['w1', 'w2', 'w3', 'w4'] as const
const faq = ['1', '2', '3', '4', '5', '6', '7', '8'] as const

/* Injector/pump section: what the job includes (left column) and the
   symptoms that bring people in (right column). Two short lists rather
   than one long paragraph — a driver scanning for their own symptom
   finds it. Injectors and injection pumps share both the symptoms and
   the test bench, so they share the section; splitting them would mean
   two blocks repeating the same list. */
const injectorWork = ['d1', 'd2', 'd3', 'd4'] as const
const injectorSymptoms = ['y1', 'y2', 'y3', 'y4', 'y5'] as const

/* Swap this one path to change the hero photograph — nothing else in
   the page depends on which file it points at. Update home.hero.photoAlt
   in content.ts to match whatever the new image actually shows, and keep
   width/height on the <img> in sync with the file or the reserved box
   stops matching and the hero starts shifting on load.

   The file is produced by `node scripts/gen-hero.mjs <source>`, which
   crops and compresses it — do not drop a raw stock download in here. */
const heroPhoto = '/images/hero-turbo.webp'

const telHref = `tel:${business.phone}`
const mailHref = `mailto:${business.email}`

/* Two-digit ordinals for the service grid and the process steps. Mono
   numerals in the corner of a cell are the cheapest way to make a grid
   read as a catalogue rather than a pile of boxes. */
const ordinal = (i: number): string => String(i + 1).padStart(2, '0')

/* ── Structured data ──────────────────────────────────────────────
   BaseLayout already emits an `Organization` node for every page. Here
   we add the two schemas that only make sense on the landing page:

   - AutoRepair (a LocalBusiness subtype): the node Google reads for the
     local pack — address, phone, hours, services offered.
   - FAQPage: mirrors the <details> block below one-to-one. The answers
     have to match the visible text, otherwise it counts as cloaking.

   Both are `is:inline` for the same reason as the Organization node in
   BaseLayout: a processed script gets deferred past the point where a
   scraper reads the document. */
const siteOrigin = Astro.site?.origin ?? Astro.url.origin

const businessJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'AutoRepair',
    '@id': `${siteOrigin}/#business`,
    name: business.name,
    legalName: business.legalName,
    description: t('home.meta.description'),
    url: siteOrigin,
    telephone: business.phone,
    email: business.email,
    /* NIP is the VAT number Google and the AI scrapers can match against
       public registries — the strongest identity signal a one-location
       business has. REGON has no schema.org property of its own, so it
       goes in as a named `identifier`. */
    vatID: business.nip,
    identifier: {
        '@type': 'PropertyValue',
        propertyID: 'REGON',
        value: business.regon,
    },
    founder: { '@type': 'Person', name: business.owner },
    address: {
        '@type': 'PostalAddress',
        streetAddress: business.street,
        postalCode: business.postalCode,
        addressLocality: business.city,
        addressRegion: business.region,
        addressCountry: business.country,
    },
    areaServed: { '@type': 'City', name: business.areaServed },
    openingHours: business.openingHours,
    makesOffer: services.map(({ key }) => ({
        '@type': 'Offer',
        itemOffered: {
            '@type': 'Service',
            name: t(`home.services.${key}.title`),
            description: t(`home.services.${key}.desc`),
        },
    })),
}

const faqJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((n) => ({
        '@type': 'Question',
        name: t(`home.faq.q${n}`),
        acceptedAnswer: { '@type': 'Answer', text: t(`home.faq.a${n}`) },
    })),
}
---

<BaseLayout title={t('home.meta.title')} description={t('home.meta.description')}>
    <Fragment slot="head">
        <script type="application/ld+json" is:inline set:html={JSON.stringify(businessJsonLd)} />
        <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
    </Fragment>

    <Navbar>
        <a
            slot="actions"
            href={telHref}
            class="theme-cta rounded-control inline-flex items-center gap-2 px-3 py-2 text-xs font-mono font-semibold whitespace-nowrap"
            aria-label={`${t('home.contact.phone')}: ${business.phoneDisplay}`}
        >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 flex-shrink-0" aria-hidden="true">
                <path d="M6.5 3.5h3l1.5 4-2 1.4a12 12 0 0 0 5.1 5.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z"/>
            </svg>
            <span class="hidden lg:inline">{business.phoneDisplay}</span>
        </a>
    </Navbar>

    <main class="flex-1">

        <!-- ═══ Hero ═══
             Split layout: copy in the left column on the page background,
             photograph full-bleed in the right half. The photo is a real
             <img> rather than a CSS background so it gets the preload
             scanner, an explicit aspect ratio (no CLS) and fetchpriority.

             The photo edge is square — the rounded corner it used to have
             was the only soft shape left on the page once the cards went
             square, and it read as an accident rather than a decision.

             Below lg the photo drops below the copy as a banner — the
             phone number and the call button stay above the fold, which
             matters more on a phone than a large picture does.

             Nothing here is `.animate`: those elements start at opacity 0
             and only reveal once the Observer's JS has run, which pushes
             the LCP paint back by the whole script-eval window. Everything
             below the fold animates; the hero paints immediately. -->
        <section class="relative isolate overflow-hidden">
            <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 pt-14 pb-12 lg:py-28 lg:min-h-[70vh] flex items-center">
                <!-- 60% column + a 42% photo overlap on the section, so at
                     exactly 1024px the copy ends 32px from the photo edge.
                     `pr-16` restores the 48px gutter the rest of the page
                     uses; above ~1200px there is slack either way. -->
                <div class="w-full lg:w-[60%] lg:pr-16">
                    <h1 class="font-heading font-bold tracking-[-0.02em] text-4xl sm:text-5xl leading-[1.1] text-balance text-fg">
                        {t('home.hero.heading')}{' '}
                        <span class="gradient-text">{t('home.hero.headingAccent')}</span>
                    </h1>

                    <p class="mt-5 text-base sm:text-lg text-muted max-w-xl leading-relaxed text-pretty">
                        {t('home.hero.sub')}
                    </p>

                    <div class="mt-9 flex flex-col sm:flex-row sm:items-center gap-3">
                        <a href={telHref} class="theme-cta rounded-control inline-flex items-center justify-center gap-2 px-8 py-4 text-sm font-semibold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                                <path d="M6.5 3.5h3l1.5 4-2 1.4a12 12 0 0 0 5.1 5.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z"/>
                            </svg>
                            {t('home.hero.cta')}
                        </a>
                        <a href="#services" class="theme-ghost rounded-control inline-flex items-center justify-center gap-2 px-8 py-4 text-sm font-medium bg-surface">
                            {t('home.hero.ctaAlt')}
                            <span aria-hidden="true">↓</span>
                        </a>
                    </div>
                </div>
            </div>

            <div class="relative overflow-hidden lg:absolute lg:inset-y-0 lg:right-0 lg:w-[42%]">
                <img
                    src={heroPhoto}
                    alt={t('home.hero.photoAlt')}
                    width="1400"
                    height="1400"
                    fetchpriority="high"
                    decoding="async"
                    class="hero-photo w-full h-64 sm:h-80 lg:h-full"
                />
            </div>
        </section>

        <!-- ═══ Trust strip ═══
             Same hairline system as the service grid: 1px gaps over a
             line-coloured container, so the cells share one rule. The old
             `divide-x` gave the third cell a left border on the two-column
             mobile layout, where it starts a row and should have none.

             `.animate` goes on the grid, never on the cells: the line
             colour lives on the container, so cells at opacity 0 leave a
             solid grey rectangle sitting there until the reveal fires.
             The whole grid fades in as one object instead. -->
        <section class="px-4 sm:px-6 border-y border-line bg-surface" aria-label={t('home.stats.aria')}>
            <ul class="max-w-6xl mx-auto grid grid-cols-2 lg:grid-cols-4 gap-px bg-line animate">
                {stats.map((key) => (
                    <li class="bg-surface px-5 sm:px-7 py-8 sm:py-10">
                        <p class="font-mono font-bold text-xl sm:text-2xl text-accent">{t(`home.stats.${key}.value`)}</p>
                        <p class="mt-2.5 text-xs sm:text-sm text-dim leading-snug">{t(`home.stats.${key}.label`)}</p>
                    </li>
                ))}
            </ul>
        </section>

        <!-- ═══ Usługi ═══
             Hairline grid (`.card-grid`): six square cells sharing one
             rule, no gutters, no shadows. Reads as a catalogue page.

             Six items divide evenly by 1, 2 and 3 columns, so no row is
             ever short. An incomplete row in a hairline grid is a bare
             rectangle of line colour — check the arithmetic before
             putting a different collection in one.

             Reveal is on the grid, not the cells — see the trust strip. -->
        <section id="services" class="cv-auto scroll-mt-24 section-padding-small px-4 sm:px-6 bg-surface">
            <div class="max-w-6xl mx-auto">
                <header class="max-w-2xl animate">
                    <h2 class="font-bold text-2xl sm:text-4xl tracking-tight text-fg text-balance">
                        {t('home.services.title')}
                    </h2>
                    <span class="block w-12 h-0.5 mt-6 bg-accent" aria-hidden="true"></span>
                    <p class="mt-6 text-muted leading-relaxed text-pretty">{t('home.services.sub')}</p>
                </header>

                <div class="card-grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 mt-12 animate">
                    {services.map(({ key, icon }, i) => (
                        <article class="theme-card group p-7 sm:p-8 flex flex-col gap-6">
                            <div class="flex items-start justify-between gap-4">
                                <span class="rounded-control w-12 h-12 flex items-center justify-center flex-shrink-0 border border-line text-accent transition-colors duration-300 group-hover:border-accent">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true">
                                        <Fragment set:html={icon} />
                                    </svg>
                                </span>
                                <span class="font-mono text-xs text-dim" aria-hidden="true">{ordinal(i)}</span>
                            </div>
                            <div>
                                <h3 class="font-semibold text-base text-fg">{t(`home.services.${key}.title`)}</h3>
                                <p class="mt-2.5 text-sm leading-relaxed text-muted">{t(`home.services.${key}.desc`)}</p>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <!-- ═══ Wtryskiwacze i pompy wtryskowe ═══
             The one pair of services that gets its own block: these are the
             ones people search for by symptom rather than by part name, so
             they need room for the symptom list that the six-cell service
             grid has no space for.

             Sits on the white background like the section above it, so the
             hairline panel is what separates the two — a second tinted band
             here would collide with the tinted `#process` below and the two
             borders would read as one 2px rule.

             Reveal is on the panel, not its halves: the right half carries
             the tint, and animating the two columns separately shows the
             ground through a hole while one of them is still at opacity 0. -->
        <section id="injectors" class="cv-auto scroll-mt-24 section-padding-small px-4 sm:px-6 bg-surface">
            <div class="max-w-6xl mx-auto border border-line animate">
                <div class="grid grid-cols-1 lg:grid-cols-2">
                    <div class="p-8 sm:p-12 border-b border-line lg:border-b-0 lg:border-r">
                        <h2 class="font-bold text-2xl sm:text-4xl tracking-tight text-fg text-balance">
                            {t('home.injectors.title')}
                        </h2>
                        <span class="block w-12 h-0.5 mt-6 bg-accent" aria-hidden="true"></span>
                        <p class="mt-6 text-muted leading-relaxed text-pretty">{t('home.injectors.sub')}</p>

                        <h3 class="mt-10 text-xs font-semibold uppercase tracking-wider text-dim">
                            {t('home.injectors.doTitle')}
                        </h3>
                        <ul class="mt-5 space-y-3.5">
                            {injectorWork.map((key) => (
                                <li class="flex gap-3.5">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 mt-1 flex-shrink-0 text-accent" aria-hidden="true">
                                        <path d="m4.5 12.5 5 5 10-11"/>
                                    </svg>
                                    <span class="text-sm leading-relaxed text-muted">{t(`home.injectors.${key}`)}</span>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div class="p-8 sm:p-12 bg-surface-soft flex flex-col">
                        <h3 class="font-semibold text-base text-fg">{t('home.injectors.symTitle')}</h3>

                        <ul class="mt-6 border-t border-line divide-y divide-line">
                            {injectorSymptoms.map((key) => (
                                <li class="flex items-start gap-3.5 py-3.5 text-sm leading-relaxed text-muted">
                                    <span class="mt-2 w-1.5 h-1.5 flex-shrink-0 bg-accent" aria-hidden="true"></span>
                                    {t(`home.injectors.${key}`)}
                                </li>
                            ))}
                        </ul>

                        <div class="mt-auto pt-8">
                            <p class="text-sm leading-relaxed text-dim text-pretty">{t('home.injectors.note')}</p>
                            <a href={telHref} class="theme-cta rounded-control mt-7 inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-semibold">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                                    <path d="M6.5 3.5h3l1.5 4-2 1.4a12 12 0 0 0 5.1 5.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z"/>
                                </svg>
                                {t('home.injectors.cta')}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ Proces ═══
             Numbered square plates joined by a hairline into a timeline.
             The connector is only rendered between steps — a trailing rule
             after the last plate would point at nothing. -->
        <section id="process" class="cv-auto scroll-mt-24 section-padding-small px-4 sm:px-6 bg-surface-soft border-y border-line">
            <div class="max-w-6xl mx-auto">
                <header class="max-w-2xl animate">
                    <h2 class="font-bold text-2xl sm:text-4xl tracking-tight text-fg text-balance">
                        {t('home.process.title')}
                    </h2>
                    <span class="block w-12 h-0.5 mt-6 bg-accent" aria-hidden="true"></span>
                    <p class="mt-6 text-muted leading-relaxed text-pretty">{t('home.process.sub')}</p>
                </header>

                <ol class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 sm:gap-8">
                    {steps.map((key, i) => (
                        <li class:list={['animate', `animate-delay-${(i + 1) * 100}`]}>
                            <div class="flex items-center gap-4">
                                <span class="rounded-control flex items-center justify-center w-12 h-12 flex-shrink-0 border border-line bg-surface font-mono text-sm font-semibold text-accent">
                                    {ordinal(i)}
                                </span>
                                {i < steps.length - 1 && (
                                    <span class="hidden lg:block flex-1 h-px -mr-8 bg-line" aria-hidden="true"></span>
                                )}
                            </div>
                            <h3 class="mt-6 font-semibold text-base text-fg">{t(`home.process.${key}.title`)}</h3>
                            <p class="mt-2.5 text-sm leading-relaxed text-muted">{t(`home.process.${key}.desc`)}</p>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <!-- ═══ Dlaczego my ═══
             Heading sticks to the top of the viewport while the argument
             list scrolls past it — the reader keeps the question in view
             while reading the answers. -->
        <section id="why" class="cv-auto scroll-mt-24 section-padding-small px-4 sm:px-6 bg-surface">
            <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[minmax(0,20rem)_1fr] gap-10 lg:gap-16">
                <div class="animate lg:sticky lg:top-28 lg:self-start">
                    <h2 class="font-bold text-2xl sm:text-4xl tracking-tight text-fg text-balance">
                        {t('home.why.title')}
                    </h2>
                    <span class="block w-12 h-0.5 mt-6 bg-accent" aria-hidden="true"></span>
                </div>

                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-10">
                    {reasons.map((key, i) => (
                        <li class:list={['border-t border-line pt-6 flex gap-4 animate', `animate-delay-${(i % 2 + 1) * 100}`]}>
                            <span class="rounded-control w-9 h-9 flex items-center justify-center flex-shrink-0 border border-line text-accent">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                                    <path d="m4.5 12.5 5 5 10-11"/>
                                </svg>
                            </span>
                            <div>
                                <h3 class="font-semibold text-base text-fg">{t(`home.why.${key}.title`)}</h3>
                                <p class="mt-2.5 text-sm leading-relaxed text-muted">{t(`home.why.${key}.desc`)}</p>
                            </div>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- ═══ FAQ ═══
             Native <details> — an accordion is one of the few interactive
             patterns the platform ships for free. A JS version would cost
             bytes and a listener per navigation for identical behaviour.
             Boxed on the tinted section so the rows read as one panel. -->
        <section id="faq" class="cv-auto scroll-mt-24 section-padding-small px-4 sm:px-6 bg-surface-soft border-y border-line">
            <div class="max-w-3xl mx-auto">
                <h2 class="font-bold text-2xl sm:text-4xl tracking-tight text-fg text-balance animate">
                    {t('home.faq.title')}
                </h2>
                <span class="block w-12 h-0.5 mt-6 bg-accent animate" aria-hidden="true"></span>

                <div class="mt-10 border border-line divide-y divide-line bg-surface animate">
                    {faq.map((n) => (
                        <details class="group">
                            <summary class="flex items-start justify-between gap-6 px-5 sm:px-7 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                                <h3 class="font-medium text-base text-fg text-pretty">{t(`home.faq.q${n}`)}</h3>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 mt-1 flex-shrink-0 text-accent transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
                                    <path d="M12 5v14M5 12h14"/>
                                </svg>
                            </summary>
                            <p class="px-5 sm:px-7 pb-6 max-w-2xl text-sm leading-relaxed text-muted text-pretty">{t(`home.faq.a${n}`)}</p>
                        </details>
                    ))}
                </div>
            </div>
        </section>

        <!-- ═══ Kontakt ═══
             The one dark block on the page. On an all-light layout the
             closing CTA needs a value jump to read as an endpoint rather
             than one more section; inverting it costs nothing and does
             that job better than another tinted panel would. The details
             sit in four ruled columns, matching the hairline grids above. -->
        <section id="contact" class="cv-auto scroll-mt-24 section-padding-small px-4 sm:px-6 bg-surface">
            <div class="max-w-6xl mx-auto">
                <div class="rounded-card p-8 sm:p-12 bg-fg text-surface animate">
                    <div class="max-w-2xl">
                        <h2 class="font-bold text-2xl sm:text-4xl tracking-tight text-balance">
                            {t('home.contact.title')}
                        </h2>
                        <p class="mt-4 text-surface/70 leading-relaxed text-pretty">{t('home.contact.sub')}</p>
                    </div>

                    <dl class="mt-12 pt-10 border-t border-surface/20 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-y-9 lg:gap-y-0 lg:divide-x lg:divide-surface/20">
                        <div class="lg:px-8 lg:first:pl-0 lg:last:pr-0">
                            <dt class="text-xs font-semibold uppercase tracking-wider text-surface/55">{t('home.contact.phone')}</dt>
                            <dd class="mt-3">
                                <a href={telHref} class="text-sm font-medium transition-opacity duration-200 hover:opacity-70">
                                    {business.phoneDisplay}
                                </a>
                            </dd>
                        </div>
                        <div class="lg:px-8 lg:first:pl-0 lg:last:pr-0">
                            <dt class="text-xs font-semibold uppercase tracking-wider text-surface/55">{t('home.contact.email')}</dt>
                            <dd class="mt-3">
                                <a href={mailHref} class="text-sm font-medium break-all transition-opacity duration-200 hover:opacity-70">
                                    {business.email}
                                </a>
                            </dd>
                        </div>
                        <div class="lg:px-8 lg:first:pl-0 lg:last:pr-0">
                            <dt class="text-xs font-semibold uppercase tracking-wider text-surface/55">{t('home.contact.address')}</dt>
                            <dd class="mt-3">
                                <address class="text-sm not-italic leading-relaxed text-surface/80">
                                    {business.street}<br />
                                    {business.postalCode} {business.city}
                                </address>
                            </dd>
                        </div>
                        <div class="lg:px-8 lg:first:pl-0 lg:last:pr-0">
                            <dt class="text-xs font-semibold uppercase tracking-wider text-surface/55">{t('home.contact.hours')}</dt>
                            <dd class="mt-3 text-sm leading-relaxed text-surface/80">{t('home.contact.hoursValue')}</dd>
                        </div>
                    </dl>

                    <div class="mt-12 flex flex-col sm:flex-row gap-3">
                        <a href={telHref} class="theme-cta rounded-control inline-flex items-center justify-center gap-2 px-8 py-4 text-sm font-semibold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                                <path d="M6.5 3.5h3l1.5 4-2 1.4a12 12 0 0 0 5.1 5.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z"/>
                            </svg>
                            {t('home.contact.cta')}
                        </a>
                        <a href={mailHref} class="rounded-control inline-flex items-center justify-center gap-2 px-8 py-4 text-sm font-medium border border-surface/25 transition-colors duration-200 hover:bg-surface/10">
                            {t('home.contact.ctaAlt')}
                        </a>
                    </div>
                </div>
            </div>
        </section>

    </main>
    <Footer />
</BaseLayout>
