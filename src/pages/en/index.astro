---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Navbar from '@/components/Navbar.astro'
import Footer from '@/components/Footer.astro'
import { useTranslations } from '@/lib/content'
import { business } from '@/lib/site.config'
import { defaultLocale } from '@/lib/locales'
import type { Locale } from '@/lib/locales'

const locale = (Astro.currentLocale ?? defaultLocale) as Locale
const t = useTranslations(locale)

/* Service blocks. The six `services` keys no longer render as a grid —
   each now has its own section — but they stay as the source for the
   `makesOffer` list in the LocalBusiness JSON-LD, which wants one short
   title + description per offer. */
const services = ['s1', 's2', 's3', 's4', 's5', 's6'] as const

/* Turbocharger block: what is done and the symptoms that bring people in.
   Diagnostics and workshop are lists of titled items / plain items. */
const turboWork = ['d1', 'd2', 'd3', 'd4', 'd5'] as const
const turboSymptoms = ['y1', 'y2', 'y3', 'y4', 'y5'] as const
const diagItems = ['t1', 't2', 't3', 't4', 't5'] as const
const workshopItems = ['w1', 'w2', 'w3', 'w4', 'w5', 'w6'] as const

/* Fault codes shown on the diagnostics readout panel. The codes are
   standard OBD-II and the same in every language; only the label beside
   each one is translated (home.diag.c1…c4). */
const diagCodes = [
    { code: 'P0299', key: 'c1' },
    { code: 'P2002', key: 'c2' },
    { code: 'P0087', key: 'c3' },
    { code: 'P0401', key: 'c4' },
] as const

const stats = ['s1', 's2', 's3'] as const
const steps = ['p1', 'p2', 'p3', 'p4'] as const
const reasons = ['w1', 'w2', 'w3', 'w4'] as const
const faq = ['1', '2', '3', '4', '5', '6', '7', '8'] as const

/* Injector/pump section: what the job includes (left column) and the
   symptoms that bring people in (right column). Two short lists rather
   than one long paragraph — a driver scanning for their own symptom
   finds it. Injectors and injection pumps share both the symptoms and
   the test bench, so they share the section; splitting them would mean
   two blocks repeating the same list. */
const injectorWork = ['d1', 'd2', 'd3', 'd4'] as const
const injectorSymptoms = ['y1', 'y2', 'y3', 'y4', 'y5'] as const

/* Particulate filter section — same shape as the injector block, same
   reason: people arrive with a symptom, not a part name. */
const dpfWork = ['d1', 'd2', 'd3', 'd4'] as const
const dpfSymptoms = ['y1', 'y2', 'y3', 'y4', 'y5'] as const

/* The hero's main image — the original photograph, not a cut-out. Its
   backdrop is near-white, not pure white, so the hero section is tinted
   to the photo's mean backdrop (`.hero-bg`) and the photo's outer edge is
   feathered (`.photo-feather`) — no cut-out, nothing removed from the part. Keep width/height in sync with the file or the
   reserved box stops matching and the hero shifts on load. Update
   home.hero.photoAlt to match whatever the image actually shows. */
const heroPhoto = '/images/photo-turbo-original.webp'

/* Photo in the "about the workshop" block. A stand-in until a picture of
   the workshop itself is supplied — replace the path (keep 4:3 or update
   width/height on the <img>) and the alt in home.about.photoAlt. */
const workshopPhoto = '/images/photo-workshop.webp'

const telHref = `tel:${business.phone}`
const mailHref = `mailto:${business.email}`

/* Plain ordinals for the process steps; the service grid shows "n / total". Mono
   numerals in the corner of a cell are the cheapest way to make a grid
   read as a catalogue rather than a pile of boxes. */
const ordinal = (i: number): string => String(i + 1)

/* ── Structured data ──────────────────────────────────────────────
   BaseLayout already emits an `Organization` node for every page. Here
   we add the two schemas that only make sense on the landing page:

   - AutoRepair (a LocalBusiness subtype): the node Google reads for the
     local pack — address, phone, hours, services offered.
   - FAQPage: mirrors the <details> block below one-to-one. The answers
     have to match the visible text, otherwise it counts as cloaking.

   Both are `is:inline` for the same reason as the Organization node in
   BaseLayout: a processed script gets deferred past the point where a
   scraper reads the document. */
const siteOrigin = Astro.site?.origin ?? Astro.url.origin

const businessJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'AutoRepair',
    '@id': `${siteOrigin}/#business`,
    name: business.name,
    legalName: business.legalName,
    description: t('home.meta.description'),
    url: siteOrigin,
    telephone: business.phone,
    email: business.email,
    /* NIP is the VAT number Google and the AI scrapers can match against
       public registries — the strongest identity signal a one-location
       business has. REGON has no schema.org property of its own, so it
       goes in as a named `identifier`. */
    vatID: business.nip,
    identifier: {
        '@type': 'PropertyValue',
        propertyID: 'REGON',
        value: business.regon,
    },
    founder: { '@type': 'Person', name: business.owner },
    address: {
        '@type': 'PostalAddress',
        streetAddress: business.street,
        postalCode: business.postalCode,
        addressLocality: business.city,
        addressRegion: business.region,
        addressCountry: business.country,
    },
    areaServed: { '@type': 'City', name: business.areaServed },
    openingHours: business.openingHours,
    makesOffer: services.map((key) => ({
        '@type': 'Offer',
        itemOffered: {
            '@type': 'Service',
            name: t(`home.services.${key}.title`),
            description: t(`home.services.${key}.desc`),
        },
    })),
}

const faqJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((n) => ({
        '@type': 'Question',
        name: t(`home.faq.q${n}`),
        acceptedAnswer: { '@type': 'Answer', text: t(`home.faq.a${n}`) },
    })),
}
---

<BaseLayout title={t('home.meta.title')} description={t('home.meta.description')}>
    <Fragment slot="head">
        <script type="application/ld+json" is:inline set:html={JSON.stringify(businessJsonLd)} />
        <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
    </Fragment>

    <Navbar>
        <a
            slot="actions"
            href={telHref}
            class="theme-cta rounded-control inline-flex items-center gap-2 px-3 py-2 text-xs font-mono font-semibold whitespace-nowrap"
            aria-label={`${t('home.contact.phone')}: ${business.phoneDisplay}`}
        >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 flex-shrink-0" aria-hidden="true">
                <path d="M6.5 3.5h3l1.5 4-2 1.4a12 12 0 0 0 5.1 5.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z"/>
            </svg>
            <span class="hidden lg:inline">{business.phoneDisplay}</span>
        </a>
    </Navbar>

    <main class="flex-1">

        <!-- ═══ Hero ═══
             Split layout: copy in the left column on the page background,
             photograph full-bleed in the right half. The photo is a real
             <img> rather than a CSS background so it gets the preload
             scanner, an explicit aspect ratio (no CLS) and fetchpriority.

             Below lg the photo drops below the copy as a banner — the
             phone number and the call button stay above the fold, which
             matters more on a phone than a large picture does.

             Nothing here is `.animate`: those elements start at opacity 0
             and only reveal once the Observer's JS has run, which pushes
             the LCP paint back by the whole script-eval window. Everything
             below the fold animates; the hero paints immediately. -->
        <section class="hero-bg relative isolate overflow-hidden">
            <!-- The filter hangs off the left edge, opposite the turbo
                 panel on the right: the two parts the workshop is known
                 for, bracketing the headline. It is deliberately mostly
                 off-canvas — enough of it to be read as a filter, not
                 enough to compete with the type.

                 It only appears from xl, and how much of it shows grows
                 with the viewport, because the room it has grows too:
                 the clearance is the container gutter plus `xl:pl-28`
                 below, so 173px at 1280 and 520px at 1920. A single
                 offset would either overflow the narrow end or leave the
                 filter as a sliver on a wide monitor, so the three steps
                 track that number — ~169 / ~241 / ~358px shown against
                 173 / 328 / 520 available. At lg the clearance is 136px
                 and the filter lands on the paragraph, which is why the
                 breakpoint is xl and not lg.

                 Not lazy: at lg it is above the fold, and a lazy image
                 there is fetched after layout, so it pops in late. It is
                 not the LCP candidate (the turbo panel is larger), hence
                 no fetchpriority. -->
            <img
                src="/images/photo-dpf-hero.webp"
                alt={t('home.hero.filterAlt')}
                width="606"
                height="620"
                decoding="async"
                class="absolute right-0 top-28 -z-10 h-auto w-64 translate-x-[35%] -scale-x-100 opacity-[0.12] min-[1280px]:left-0 min-[1280px]:right-auto min-[1280px]:top-auto min-[1280px]:bottom-0 min-[1280px]:scale-x-100 min-[1280px]:opacity-100 min-[1280px]:translate-y-[14%] min-[1280px]:w-[22rem] min-[1280px]:-translate-x-[52%] min-[1536px]:w-[26rem] min-[1536px]:-translate-x-[42%] min-[1800px]:w-[32rem] min-[1800px]:-translate-x-[30%]"
            />

            <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 xl:pl-28 lg:translate-x-6 min-[1280px]:translate-x-12 pt-14 pb-12 lg:py-24 lg:min-h-[70vh] flex flex-col lg:flex-row items-center gap-10 lg:gap-6">
                <div class="w-full lg:w-[54%] lg:pr-8">
                    <h1 class="font-heading font-bold tracking-[-0.02em] text-4xl sm:text-5xl leading-[1.1] text-balance text-fg">
                        {t('home.hero.heading')}{' '}
                        <span class="font-mono font-semibold tracking-tight whitespace-nowrap">{t('home.hero.headingAccent')}</span>
                    </h1>

                    <p class="mt-6 text-base sm:text-lg text-muted max-w-xl leading-relaxed text-pretty">
                        {t('home.hero.sub')}
                    </p>

                    <div class="mt-9 flex flex-col sm:flex-row sm:items-center gap-3">
                        <a href={telHref} class="theme-cta rounded-control inline-flex items-center justify-center gap-2 px-8 py-4 text-sm font-semibold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                                <path d="M6.5 3.5h3l1.5 4-2 1.4a12 12 0 0 0 5.1 5.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z"/>
                            </svg>
                            {t('home.hero.cta')}
                        </a>
                        <a href="#turbo" class="theme-ghost rounded-control inline-flex items-center justify-center gap-2 px-8 py-4 text-sm font-medium bg-surface">
                            {t('home.hero.ctaAlt')}
                            <span aria-hidden="true">↓</span>
                        </a>
                    </div>
                </div>

                <!-- The turbo used to be a full-bleed photograph pinned to
                     the right edge of the viewport. It is now a cut-out
                     inside the container, for two reasons:

                     - it matches the filter on the left, so the hero reads
                       as two parts bracketing the headline rather than a
                       floating object next to a photo panel, and
                     - pinned to the viewport edge it drifted further from
                       the copy the wider the monitor got, leaving a hole
                       in the middle of the hero at 1920. In the container
                       it keeps its distance from the text at every width.

                     `fetchpriority="high"`: this is the hero's LCP
                     candidate and it is not lazy. -->
                <div class="w-full lg:w-[46%] flex justify-center lg:justify-end">
                    <div class="relative w-full max-w-sm sm:max-w-md lg:max-w-none">
                        <img
                            src={heroPhoto}
                            alt={t('home.hero.photoAlt')}
                            width="1080"
                            height="924"
                            fetchpriority="high"
                            decoding="async"
                            class="w-full h-auto photo-feather origin-right min-[1024px]:scale-[1.15] min-[1280px]:scale-[1.22] min-[1440px]:scale-[1.3] min-[1280px]:translate-x-[5rem] min-[1440px]:translate-x-36 min-[1536px]:translate-x-[10.5rem]"
                        />
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ O warsztacie ═══
             The first thing under the hero: who the workshop is, how long
             it has been doing this and where it is. It comes before the
             service blocks because a visitor who has never heard of the
             business needs that before a list of what it repairs.

             The photograph is a stand-in (`workshopPhoto`) until a picture
             of the workshop itself arrives; swap the constant in the
             frontmatter and keep the 4:3 ratio, or adjust width/height.
             On a phone the text comes first and the picture follows. -->
        <section id="about" class="cv-auto scroll-mt-24 section-padding-small px-4 sm:px-6 bg-surface">
            <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
                <div class="animate">
                    <h2 class="font-bold text-2xl sm:text-4xl tracking-tight text-fg text-balance">
                        {t('home.about.title')}
                    </h2>
                    <span class="block w-12 h-0.5 mt-6 bg-accent" aria-hidden="true"></span>
                    <p class="mt-6 text-muted leading-relaxed text-pretty">{t('home.about.p1')}</p>
                    <p class="mt-4 text-muted leading-relaxed text-pretty">{t('home.about.p2')}</p>

                    <dl class="mt-9 grid grid-cols-1 sm:grid-cols-2 gap-px bg-line border border-line">
                        <div class="bg-surface px-6 py-6">
                            <dt class="text-xs font-semibold uppercase tracking-wider text-dim">{t('home.about.yearsLabel')}</dt>
                            <dd class="mt-2 font-mono font-bold text-3xl text-accent">{t('home.about.yearsValue')}</dd>
                        </div>
                        <div class="bg-surface px-6 py-6">
                            <dt class="text-xs font-semibold uppercase tracking-wider text-dim">{t('home.about.placeLabel')}</dt>
                            <dd class="mt-2 text-sm leading-relaxed text-fg">
                                <address class="not-italic">
                                    {business.street}<br />
                                    {business.postalCode} {business.city}
                                </address>
                            </dd>
                        </div>
                    </dl>
                </div>

                <img
                    src={workshopPhoto}
                    alt={t('home.about.photoAlt')}
                    width="1440"
                    height="720"
                    loading="lazy"
                    decoding="async"
                    class="w-full aspect-[4/3] object-cover border border-line animate"
                />
            </div>
        </section>

        <!-- ═══ Trust strip ═══
             Same hairline system as the service grid: 1px gaps over a
             line-coloured container, so the cells share one rule. The old
             `divide-x` gave the third cell a left border on the two-column
             mobile layout, where it starts a row and should have none.

             `.animate` goes on the grid, never on the cells: the line
             colour lives on the container, so cells at opacity 0 leave a
             solid grey rectangle sitting there until the reveal fires.
             The whole grid fades in as one object instead. -->
        <section class="px-4 sm:px-6 border-y border-line bg-surface" aria-label={t('home.stats.aria')}>
            <ul class="max-w-6xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-px bg-line animate">
                {stats.map((key) => (
                    <li class="bg-surface px-5 sm:px-7 py-8 sm:py-10">
                        <p class="font-mono font-bold text-xl sm:text-2xl text-accent">{t(`home.stats.${key}.value`)}</p>
                        <p class="mt-2.5 text-xs sm:text-sm text-dim leading-snug">{t(`home.stats.${key}.label`)}</p>
                    </li>
                ))}
            </ul>
        </section>

        <!-- ═══ Turbosprężarki ═══
             The workshop's namesake, so it opens the service blocks. Same
             vocabulary as the two panels below — a checklist of what is
             done and a list of the symptoms that bring people in — but
             open on the page instead of boxed, so three framed panels in a
             row don't read as one pattern repeated.

             The heading sits above the grid, not in it: on a phone the
             order is heading, picture, lists, call button, and on desktop
             the picture and the lists share a row under one heading.
             The cut-out is on pure white, so it stays on the white ground. -->
        <section id="turbo" class="cv-auto scroll-mt-24 section-padding-small px-4 sm:px-6 bg-surface">
            <div class="max-w-6xl mx-auto">
                <header class="max-w-2xl animate">
                    <h2 class="font-bold text-2xl sm:text-4xl tracking-tight text-fg text-balance">
                        {t('home.turbo.title')}
                    </h2>
                    <span class="block w-12 h-0.5 mt-6 bg-accent" aria-hidden="true"></span>
                    <p class="mt-6 text-muted leading-relaxed text-pretty">{t('home.turbo.sub')}</p>
                </header>

                <div class="mt-12 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
                    <!-- A photograph on a white backdrop (corners 252–255), so
                         the section is plain white and the picture needs no
                         frame, tint or feathering. -->
                    <img
                        src="/images/photo-turbo-twin.webp"
                        alt={t('home.turbo.photoAlt')}
                        width="1080"
                        height="869"
                        loading="lazy"
                        decoding="async"
                        class="w-full max-w-md sm:max-w-lg lg:max-w-none mx-auto h-auto animate"
                    />

                    <div class="animate">
                        <h3 class="text-xs font-semibold uppercase tracking-wider text-dim">
                            {t('home.turbo.doTitle')}
                        </h3>
                        <ul class="mt-5 space-y-3.5">
                            {turboWork.map((key) => (
                                <li class="flex gap-3.5">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 mt-1 flex-shrink-0 text-accent" aria-hidden="true">
                                        <path d="m4.5 12.5 5 5 10-11"/>
                                    </svg>
                                    <span class="text-sm leading-relaxed text-muted">{t(`home.turbo.${key}`)}</span>
                                </li>
                            ))}
                        </ul>

                        <h3 class="mt-10 font-semibold text-base text-fg">{t('home.turbo.symTitle')}</h3>
                        <ul class="mt-5 border-t border-line divide-y divide-line">
                            {turboSymptoms.map((key) => (
                                <li class="flex items-start gap-3.5 py-3.5 text-sm leading-relaxed text-muted">
                                    <span class="mt-2 w-1.5 h-1.5 flex-shrink-0 bg-accent" aria-hidden="true"></span>
                                    {t(`home.turbo.${key}`)}
                                </li>
                            ))}
                        </ul>

                        <p class="mt-8 text-sm leading-relaxed text-dim text-pretty">{t('home.turbo.note')}</p>
                        <a href={telHref} class="theme-cta rounded-control mt-7 inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-semibold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                                <path d="M6.5 3.5h3l1.5 4-2 1.4a12 12 0 0 0 5.1 5.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z"/>
                            </svg>
                            {t('home.turbo.cta')}
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ Filtry DPF ═══
             Same open layout as the turbocharger block above — heading on
             top, picture and lists in a row under it — with the picture on
             the other side (`lg:order-last`) and a tinted ground, so the
             blocks alternate instead of stacking the same shape. On a
             phone the DOM order is the reading order: picture first. The
             cut-out has an alpha channel, so it sits on either ground. -->
        <section id="dpf" class="cv-auto scroll-mt-24 section-padding-small px-4 sm:px-6 bg-surface">
            <div class="max-w-6xl mx-auto">
                <header class="max-w-2xl animate">
                    <h2 class="font-bold text-2xl sm:text-4xl tracking-tight text-fg text-balance">
                        {t('home.dpf.title')}
                    </h2>
                    <span class="block w-12 h-0.5 mt-6 bg-accent" aria-hidden="true"></span>
                    <p class="mt-6 text-muted leading-relaxed text-pretty">{t('home.dpf.sub')}</p>
                </header>

                <div class="mt-12 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
                    <!-- Two photographs of different filters, whole and cut
                         open. Both have pure-white backgrounds, so they sit on
                         the white section with no frame. -->
                    <div class="flex items-center justify-center gap-4 sm:gap-6 w-full max-w-lg mx-auto lg:max-w-none animate lg:order-last">
                        <img
                            src="/images/photo-dpf-clean.webp"
                            alt={t('home.dpf.photoAlt')}
                            width="800"
                            height="800"
                            loading="lazy"
                            decoding="async"
                            class="w-1/2 h-auto"
                        />
                        <img
                            src="/images/photo-dpf-cutaway.webp"
                            alt={t('home.dpf.photoCutawayAlt')}
                            width="620"
                            height="465"
                            loading="lazy"
                            decoding="async"
                            class="w-1/2 h-auto"
                        />
                    </div>

                    <div class="animate">
                        <h3 class="text-xs font-semibold uppercase tracking-wider text-dim">
                            {t('home.dpf.doTitle')}
                        </h3>
                        <ul class="mt-5 space-y-3.5">
                            {dpfWork.map((key) => (
                                <li class="flex gap-3.5">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 mt-1 flex-shrink-0 text-accent" aria-hidden="true">
                                        <path d="m4.5 12.5 5 5 10-11"/>
                                    </svg>
                                    <span class="text-sm leading-relaxed text-muted">{t(`home.dpf.${key}`)}</span>
                                </li>
                            ))}
                        </ul>

                        <h3 class="mt-10 font-semibold text-base text-fg">{t('home.dpf.symTitle')}</h3>
                        <ul class="mt-5 border-t border-line divide-y divide-line">
                            {dpfSymptoms.map((key) => (
                                <li class="flex items-start gap-3.5 py-3.5 text-sm leading-relaxed text-muted">
                                    <span class="mt-2 w-1.5 h-1.5 flex-shrink-0 bg-accent" aria-hidden="true"></span>
                                    {t(`home.dpf.${key}`)}
                                </li>
                            ))}
                        </ul>

                        <p class="mt-8 text-sm leading-relaxed text-dim text-pretty">{t('home.dpf.note')}</p>
                        <a href={telHref} class="theme-cta rounded-control mt-7 inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-semibold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                                <path d="M6.5 3.5h3l1.5 4-2 1.4a12 12 0 0 0 5.1 5.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z"/>
                            </svg>
                            {t('home.dpf.cta')}
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ Wtryskiwacze i pompy wtryskowe ═══
             Same layout again, picture on the left, white ground. The two
             parts (injectors and pump) stand side by side as one visual.
             They share the symptoms and the test bench, so they share the
             section — splitting them would repeat the same lists. -->
        <section id="injectors" class="cv-auto scroll-mt-24 section-padding-small px-4 sm:px-6 bg-surface">
            <div class="max-w-6xl mx-auto">
                <header class="max-w-2xl animate">
                    <h2 class="font-bold text-2xl sm:text-4xl tracking-tight text-fg text-balance">
                        {t('home.injectors.title')}
                    </h2>
                    <span class="block w-12 h-0.5 mt-6 bg-accent" aria-hidden="true"></span>
                    <p class="mt-6 text-muted leading-relaxed text-pretty">{t('home.injectors.sub')}</p>
                </header>

                <div class="mt-12 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
                    <div class="flex items-end justify-center gap-6 sm:gap-10 animate">
                        <img
                            src="/images/photo-injectors.webp"
                            alt={t('home.why.photoAlt')}
                            width="564"
                            height="524"
                            loading="lazy"
                            decoding="async"
                            class="w-28 sm:w-44 h-auto"
                        />
                        <img
                            src="/images/photo-pump.webp"
                            alt={t('home.services.photoAlt')}
                            width="564"
                            height="440"
                            loading="lazy"
                            decoding="async"
                            class="w-40 sm:w-60 h-auto"
                        />
                    </div>

                    <div class="animate">
                        <h3 class="text-xs font-semibold uppercase tracking-wider text-dim">
                            {t('home.injectors.doTitle')}
                        </h3>
                        <ul class="mt-5 space-y-3.5">
                            {injectorWork.map((key) => (
                                <li class="flex gap-3.5">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 mt-1 flex-shrink-0 text-accent" aria-hidden="true">
                                        <path d="m4.5 12.5 5 5 10-11"/>
                                    </svg>
                                    <span class="text-sm leading-relaxed text-muted">{t(`home.injectors.${key}`)}</span>
                                </li>
                            ))}
                        </ul>

                        <h3 class="mt-10 font-semibold text-base text-fg">{t('home.injectors.symTitle')}</h3>
                        <ul class="mt-5 border-t border-line divide-y divide-line">
                            {injectorSymptoms.map((key) => (
                                <li class="flex items-start gap-3.5 py-3.5 text-sm leading-relaxed text-muted">
                                    <span class="mt-2 w-1.5 h-1.5 flex-shrink-0 bg-accent" aria-hidden="true"></span>
                                    {t(`home.injectors.${key}`)}
                                </li>
                            ))}
                        </ul>

                        <p class="mt-8 text-sm leading-relaxed text-dim text-pretty">{t('home.injectors.note')}</p>
                        <a href={telHref} class="theme-cta rounded-control mt-7 inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-semibold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                                <path d="M6.5 3.5h3l1.5 4-2 1.4a12 12 0 0 0 5.1 5.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z"/>
                            </svg>
                            {t('home.injectors.cta')}
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ Diagnostyka komputerowa ═══
             There is no photograph of diagnostics worth using, so the
             visual is a controller readout drawn in the page's own tokens:
             a dark square panel (the same inverted surface as the contact
             block) with a few real fault codes in mono type. Decorative —
             the list beside it carries the content, hence `aria-hidden`.
             The codes themselves are language-neutral (see `diagCodes`). -->
        <section id="diagnostics" class="relative isolate overflow-hidden cv-auto scroll-mt-24 section-padding-small px-4 sm:px-6 bg-surface-soft border-y border-line">
            <!-- Same honeycomb ground as `#process` and `#faq`: a band
                 behind the heading on a phone, two flanks from lg. -->
            <img
                src="/images/texture-honeycomb.webp"
                alt=""
                aria-hidden="true"
                width="700"
                height="300"
                loading="lazy"
                decoding="async"
                class="texture-band -z-10 lg:hidden"
            />
            <img
                src="/images/texture-honeycomb.webp"
                alt=""
                aria-hidden="true"
                width="700"
                height="300"
                loading="lazy"
                decoding="async"
                class="texture-flank texture-flank-left -z-10 hidden lg:block"
            />
            <img
                src="/images/texture-honeycomb.webp"
                alt=""
                aria-hidden="true"
                width="700"
                height="300"
                loading="lazy"
                decoding="async"
                class="texture-flank texture-flank-right -z-10 hidden lg:block"
            />
            <div class="max-w-6xl mx-auto">
                <header class="max-w-2xl animate">
                    <h2 class="font-bold text-2xl sm:text-4xl tracking-tight text-fg text-balance">
                        {t('home.diag.title')}
                    </h2>
                    <span class="block w-12 h-0.5 mt-6 bg-accent" aria-hidden="true"></span>
                    <p class="mt-6 text-muted leading-relaxed text-pretty">{t('home.diag.sub')}</p>
                </header>

                <div class="mt-12 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
                    <div class="w-full max-w-md mx-auto lg:max-w-none bg-fg text-surface p-6 sm:p-8 font-mono animate lg:order-last" aria-hidden="true">
                        <p class="text-xs uppercase tracking-wider text-surface/60">{t('home.diag.screenTitle')}</p>
                        <ul class="mt-5 border-t border-surface/20 divide-y divide-surface/20">
                            {diagCodes.map(({ code, key }) => (
                                <li class="flex items-start gap-4 py-3.5 text-xs sm:text-sm leading-relaxed">
                                    <span class="font-bold flex-shrink-0">{code}</span>
                                    <span class="text-surface/75">{t(`home.diag.${key}`)}</span>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div class="animate">
                        <ul class="border-t border-line divide-y divide-line">
                            {diagItems.map((key) => (
                                <li class="flex items-start gap-4 py-5">
                                    <span class="mt-2 w-1.5 h-1.5 flex-shrink-0 bg-accent" aria-hidden="true"></span>
                                    <div>
                                        <h3 class="font-semibold text-base text-fg">{t(`home.diag.${key}.title`)}</h3>
                                        <p class="mt-2 text-sm leading-relaxed text-muted">{t(`home.diag.${key}.desc`)}</p>
                                    </div>
                                </li>
                            ))}
                        </ul>

                        <a href={telHref} class="theme-cta rounded-control mt-8 inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-semibold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                                <path d="M6.5 3.5h3l1.5 4-2 1.4a12 12 0 0 0 5.1 5.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z"/>
                            </svg>
                            {t('home.diag.cta')}
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ Warsztat ═══
             The general-repair side of the business. The list on the left
             is what is done; the dark panel on the right (same inverted
             surface as the diagnostics readout and the contact block) is
             the business card — address and a call button — so the block
             ends in a way to reach the workshop, not in another list.
             White ground, so the next block (`#process`, tinted) gets its
             own border. -->
        <section id="workshop" class="cv-auto scroll-mt-24 section-padding-small px-4 sm:px-6 bg-surface">
            <div class="max-w-6xl mx-auto">
                <header class="max-w-2xl animate">
                    <h2 class="font-bold text-2xl sm:text-4xl tracking-tight text-fg text-balance">
                        {t('home.workshop.title')}
                    </h2>
                    <span class="block w-12 h-0.5 mt-6 bg-accent" aria-hidden="true"></span>
                    <p class="mt-6 text-muted leading-relaxed text-pretty">{t('home.workshop.sub')}</p>
                </header>

                <div class="mt-12 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-stretch">
                    <ul class="border-t border-line divide-y divide-line animate">
                        {workshopItems.map((key) => (
                            <li class="flex gap-3.5 py-4">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 mt-1 flex-shrink-0 text-accent" aria-hidden="true">
                                    <path d="m4.5 12.5 5 5 10-11"/>
                                </svg>
                                <span class="text-sm leading-relaxed text-muted">{t(`home.workshop.${key}`)}</span>
                            </li>
                        ))}
                    </ul>

                    <div class="bg-fg text-surface p-8 sm:p-10 flex flex-col animate">
                        <h3 class="font-bold text-xl sm:text-2xl tracking-tight text-balance">{t('home.workshop.panelTitle')}</h3>
                        <p class="mt-4 text-sm leading-relaxed text-surface/70 text-pretty">{t('home.workshop.note')}</p>
                        <address class="mt-6 text-sm not-italic leading-relaxed text-surface/80">
                            {business.street}<br />
                            {business.postalCode} {business.city}
                        </address>
                        <a href={telHref} class="theme-cta rounded-control mt-8 self-start inline-flex items-center justify-center gap-2 px-6 py-3.5 text-sm font-semibold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                                <path d="M6.5 3.5h3l1.5 4-2 1.4a12 12 0 0 0 5.1 5.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z"/>
                            </svg>
                            {t('home.workshop.cta')}
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ Proces ═══
             Numbered square plates joined by a hairline into a timeline.
             The connector is only rendered between steps — a trailing rule
             after the last plate would point at nothing. -->
        <section id="process" class="relative isolate overflow-hidden cv-auto scroll-mt-24 section-padding-small px-4 sm:px-6 bg-surface-soft border-y border-line">
            <img
                src="/images/texture-honeycomb.webp"
                alt=""
                aria-hidden="true"
                width="700"
                height="300"
                loading="lazy"
                decoding="async"
                class="texture-band -z-10 lg:hidden"
            />
            <!-- Monolith honeycomb, shot down the face of a cleaned filter.
                 Two flanks rather than one full-bleed layer: the measured
                 contrast of the old band passed AA, but a high-frequency
                 grid behind 14px copy still reads as noise, which is not
                 something a ratio captures. `.texture-flank` is sized off
                 the gap beside the content column, so the texture now
                 stops before the first character and collapses to zero
                 width when there is no gap left. See .texture-flank. -->
            <img
                src="/images/texture-honeycomb.webp"
                alt=""
                aria-hidden="true"
                width="700"
                height="300"
                loading="lazy"
                decoding="async"
                class="texture-flank texture-flank-left -z-10 hidden lg:block"
            />
            <img
                src="/images/texture-honeycomb.webp"
                alt=""
                aria-hidden="true"
                width="700"
                height="300"
                loading="lazy"
                decoding="async"
                class="texture-flank texture-flank-right -z-10 hidden lg:block"
            />
            <div class="max-w-6xl mx-auto">
                <header class="max-w-2xl animate">
                    <h2 class="font-bold text-2xl sm:text-4xl tracking-tight text-fg text-balance">
                        {t('home.process.title')}
                    </h2>
                    <span class="block w-12 h-0.5 mt-6 bg-accent" aria-hidden="true"></span>
                    <p class="mt-6 text-muted leading-relaxed text-pretty">{t('home.process.sub')}</p>
                </header>

                <ol class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 sm:gap-8">
                    {steps.map((key, i) => (
                        <li class:list={['animate', `animate-delay-${(i + 1) * 100}`]}>
                            <div class="flex items-center gap-4">
                                <span class="rounded-control flex items-center justify-center w-12 h-12 flex-shrink-0 border border-line bg-surface font-mono text-sm font-semibold text-accent">
                                    {ordinal(i)}
                                </span>
                                {i < steps.length - 1 && (
                                    <span class="hidden lg:block flex-1 h-px -mr-8 bg-line" aria-hidden="true"></span>
                                )}
                            </div>
                            <h3 class="mt-6 font-semibold text-base text-fg">{t(`home.process.${key}.title`)}</h3>
                            <p class="mt-2.5 text-sm leading-relaxed text-muted">{t(`home.process.${key}.desc`)}</p>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <!-- ═══ Dlaczego my ═══
             Heading sticks to the top of the viewport while the argument
             list scrolls past it — the reader keeps the question in view
             while reading the answers. -->
        <section id="why" class="cv-auto scroll-mt-24 section-padding-small px-4 sm:px-6 bg-surface">
            <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[minmax(0,20rem)_1fr] gap-10 lg:gap-16">
                <div class="animate lg:sticky lg:top-28 lg:self-start">
                    <h2 class="font-bold text-2xl sm:text-4xl tracking-tight text-fg text-balance">
                        {t('home.why.title')}
                    </h2>
                    <span class="block w-12 h-0.5 mt-6 bg-accent" aria-hidden="true"></span>

                    <!-- Only the top of the filter — rim and mesh face — fading
                         out at the bottom edge, so it reads as a part rising
                         out of the heading rather than a third copy of the
                         photo. Desktop only: on a phone this column is just
                         the heading and the picture would push the list down
                         for nothing. Decorative, hence no alt. -->
                    <div class="hidden lg:block mt-10 w-64 h-40 overflow-hidden [mask-image:linear-gradient(to_bottom,#000_55%,transparent)]" aria-hidden="true">
                        <img src="/images/photo-dpf-hero.webp" alt="" width="606" height="620" loading="lazy" decoding="async" class="w-64 h-auto" />
                    </div>
                </div>

                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-10">
                    {reasons.map((key, i) => (
                        <li class:list={['border-t border-line pt-6 flex gap-4 animate', `animate-delay-${(i % 2 + 1) * 100}`]}>
                            <span class="rounded-control w-9 h-9 flex items-center justify-center flex-shrink-0 border border-line text-accent">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                                    <path d="m4.5 12.5 5 5 10-11"/>
                                </svg>
                            </span>
                            <div>
                                <h3 class="font-semibold text-base text-fg">{t(`home.why.${key}.title`)}</h3>
                                <p class="mt-2.5 text-sm leading-relaxed text-muted">{t(`home.why.${key}.desc`)}</p>
                            </div>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- ═══ FAQ ═══
             Native <details> — an accordion is one of the few interactive
             patterns the platform ships for free. A JS version would cost
             bytes and a listener per navigation for identical behaviour.
             Boxed on the tinted section so the rows read as one panel. -->
        <section id="faq" class="relative isolate overflow-hidden cv-auto scroll-mt-24 section-padding-small px-4 sm:px-6 bg-surface-soft border-y border-line">
            <img
                src="/images/texture-honeycomb.webp"
                alt=""
                aria-hidden="true"
                width="700"
                height="300"
                loading="lazy"
                decoding="async"
                class="texture-band -z-10 lg:hidden"
            />
            <!-- Monolith honeycomb, shot down the face of a cleaned filter.
                 Two flanks rather than one full-bleed layer: the measured
                 contrast of the old band passed AA, but a high-frequency
                 grid behind 14px copy still reads as noise, which is not
                 something a ratio captures. `.texture-flank` is sized off
                 the gap beside the max-w-3xl column, so the texture now
                 stops before the first character and collapses to zero
                 width when there is no gap left. See .texture-flank. -->
            <img
                src="/images/texture-honeycomb.webp"
                alt=""
                aria-hidden="true"
                width="700"
                height="300"
                loading="lazy"
                decoding="async"
                class="texture-flank texture-flank-left -z-10 hidden lg:block"
            />
            <img
                src="/images/texture-honeycomb.webp"
                alt=""
                aria-hidden="true"
                width="700"
                height="300"
                loading="lazy"
                decoding="async"
                class="texture-flank texture-flank-right -z-10 hidden lg:block"
            />
            <div class="max-w-3xl mx-auto">
                <h2 class="font-bold text-2xl sm:text-4xl tracking-tight text-fg text-balance animate">
                    {t('home.faq.title')}
                </h2>
                <span class="block w-12 h-0.5 mt-6 bg-accent animate" aria-hidden="true"></span>

                <div class="mt-10 border border-line divide-y divide-line bg-surface animate">
                    {faq.map((n) => (
                        <details class="group">
                            <summary class="flex items-start justify-between gap-6 px-5 sm:px-7 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                                <h3 class="font-medium text-base text-fg text-pretty">{t(`home.faq.q${n}`)}</h3>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 mt-1 flex-shrink-0 text-accent transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
                                    <path d="M12 5v14M5 12h14"/>
                                </svg>
                            </summary>
                            <p class="px-5 sm:px-7 pb-6 max-w-2xl text-sm leading-relaxed text-muted text-pretty">{t(`home.faq.a${n}`)}</p>
                        </details>
                    ))}
                </div>
            </div>
        </section>

        <!-- ═══ Kontakt ═══
             The one dark block on the page. On an all-light layout the
             closing CTA needs a value jump to read as an endpoint rather
             than one more section; inverting it costs nothing and does
             that job better than another tinted panel would. The details
             sit in four ruled columns, matching the hairline grids above. -->
        <section id="contact" class="cv-auto scroll-mt-24 section-padding-small px-4 sm:px-6 bg-surface">
            <div class="max-w-6xl mx-auto">
                <div class="relative isolate overflow-hidden rounded-card p-8 sm:p-12 bg-fg text-surface animate">
                    <!-- A clogged, corroded filter on dark concrete. It works
                         here and nowhere else on the page: its own background
                         is already dark, so on the inverted panel it ghosts
                         out of the surface instead of sitting on it as a
                         pasted rectangle. overflow-hidden clips it to the
                         card radius. -->
                    <img
                        src="/images/texture-filter.webp"
                        alt=""
                        aria-hidden="true"
                        width="640"
                        height="640"
                        loading="lazy"
                        decoding="async"
                        class="texture-layer texture-filter -z-10"
                    />
                    <div class="max-w-2xl">
                        <h2 class="font-bold text-2xl sm:text-4xl tracking-tight text-balance">
                            {t('home.contact.title')}
                        </h2>
                        <p class="mt-4 text-surface/70 leading-relaxed text-pretty">{t('home.contact.sub')}</p>
                    </div>

                    <dl class="mt-12 pt-10 border-t border-surface/20 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-y-9 lg:gap-y-0 lg:divide-x lg:divide-surface/20">
                        <div class="lg:px-8 lg:first:pl-0 lg:last:pr-0">
                            <dt class="text-xs font-semibold uppercase tracking-wider text-surface/55">{t('home.contact.phone')}</dt>
                            <dd class="mt-3">
                                <a href={telHref} class="text-sm font-medium transition-opacity duration-200 hover:opacity-70">
                                    {business.phoneDisplay}
                                </a>
                            </dd>
                        </div>
                        <div class="lg:px-8 lg:first:pl-0 lg:last:pr-0">
                            <dt class="text-xs font-semibold uppercase tracking-wider text-surface/55">{t('home.contact.email')}</dt>
                            <dd class="mt-3">
                                <a href={mailHref} class="text-sm font-medium break-all transition-opacity duration-200 hover:opacity-70">
                                    {business.email}
                                </a>
                            </dd>
                        </div>
                        <div class="lg:px-8 lg:first:pl-0 lg:last:pr-0">
                            <dt class="text-xs font-semibold uppercase tracking-wider text-surface/55">{t('home.contact.address')}</dt>
                            <dd class="mt-3">
                                <address class="text-sm not-italic leading-relaxed text-surface/80">
                                    {business.street}<br />
                                    {business.postalCode} {business.city}
                                </address>
                            </dd>
                        </div>
                        <div class="lg:px-8 lg:first:pl-0 lg:last:pr-0">
                            <dt class="text-xs font-semibold uppercase tracking-wider text-surface/55">{t('home.contact.hours')}</dt>
                            <dd class="mt-3 text-sm leading-relaxed text-surface/80">{t('home.contact.hoursValue')}</dd>
                        </div>
                    </dl>

                    <div class="mt-12 flex flex-col sm:flex-row gap-3">
                        <a href={telHref} class="theme-cta rounded-control inline-flex items-center justify-center gap-2 px-8 py-4 text-sm font-semibold">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                                <path d="M6.5 3.5h3l1.5 4-2 1.4a12 12 0 0 0 5.1 5.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z"/>
                            </svg>
                            {t('home.contact.cta')}
                        </a>
                        <a href={mailHref} class="rounded-control inline-flex items-center justify-center gap-2 px-8 py-4 text-sm font-medium border border-surface/25 transition-colors duration-200 hover:bg-surface/10">
                            {t('home.contact.ctaAlt')}
                        </a>
                    </div>
                </div>
            </div>
        </section>

    </main>
    <Footer />
</BaseLayout>
